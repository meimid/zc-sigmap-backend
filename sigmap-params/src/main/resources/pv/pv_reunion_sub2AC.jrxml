	<parameter name="reunion" class="java.lang.Integer"/>
	<parameter name="acId" class="java.lang.Integer"/>
	<parameter name="ppm_id" class="java.lang.Integer"/>
	<parameter name="ppm_ver" class="java.lang.Integer"/>
	<parameter name="dac_id" class="java.lang.Integer"/>
	<parameter name="dac_ver" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    r.reunion_id,
    r.ppm_id,
    r.ppm_ver,
    r.observation,
    r.decision,
    p.ref,
    p.nom,
    p.annee,
    p.budget_estime,
    m.com_id,
    m.nom as comnom, 'PPM' as type
FROM reunion_ppm r
INNER JOIN ppm p
       ON r.ppm_id = p.ppm_id
      AND r.ppm_ver = p.ppm_ver
INNER JOIN ac a
       ON p.ac_id = a.ac_id
INNER JOIN com m on a.com_id = m.com_id
WHERE r.reunion_id =  $P{reunion}  and p.ac_id= $P{acId} 
AND (
      -- Cas 1: Si PPM_ID et PPM_VER sont fournis
      ($P{ppm_id} IS NOT NULL AND $P{ppm_ver} IS NOT NULL 
       AND p.ppm_id = $P{ppm_id} AND p.ppm_ver = $P{ppm_ver})
      OR
      -- Cas 3: Tous les paramètres sont NULL
      ($P{ppm_id} IS NULL AND $P{ppm_ver} IS NULL 
       AND $P{dac_id} IS NULL AND $P{dac_ver} IS NULL)
  )
union
SELECT
    r.reunion_id,
    r.dac_id,
    r.dac_ver,
    r.observation,
    r.decision,
    p.ref,
    p.nom,
    p.annee,
    p.budget_estime,
     m.com_id,
    m.nom as comnom, 'DAC' as type
FROM reunion_dac r
INNER JOIN dac d
       ON r.dac_id = d.dac_id
      AND r.dac_ver = d.dac_ver
     INNER JOIN  appel_offre ap on d.appel_offre_id=ap.appel_offre_id
    INNER JOIN ppm p on ap.ppm_id=p.ppm_id and ap.ppm_ver=p.ppm_ver 
INNER JOIN ac a
       ON p.ac_id = a.ac_id
INNER JOIN com m on a.com_id = m.com_id
WHERE r.reunion_id =   $P{reunion} and p.ac_id= $P{acId}
AND (
      -- Cas 2: Si DAC_ID et DAC_VER sont fournis
      ($P{dac_id} IS NOT NULL AND $P{dac_ver} IS NOT NULL 
       AND d.dac_id = $P{dac_id} AND d.dac_ver = $P{dac_ver})
      OR
      -- Cas 3: Tous les paramètres sont NULL
      ($P{ppm_id} IS NULL AND $P{ppm_ver} IS NULL 
       AND $P{dac_id} IS NULL AND $P{dac_ver} IS NULL)
  )]]>
	</queryString>
