	<subDataset name="Dataset1" uuid="2101a4cb-b120-4dac-9add-f4828119eb04">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter-SIGMAP-DEV.jrdax"/>
		<parameter name="reunion" class="java.lang.Integer"/>
		<parameter name="com" class="java.lang.Integer"/>
		<parameter name="ppm_id" class="java.lang.Integer"/>
		<parameter name="ppm_ver" class="java.lang.Integer"/>
		<parameter name="code" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT distinct
    r.reunion_id,
    r.ppm_id,
    r.ppm_ver,
    r.observation,CASE UPPER(r.decision)
        WHEN 'APPROVE' THEN 'Avis de non-objection'
        WHEN 'VALIDATE' THEN 'Approuvé'
        WHEN 'REJECT' THEN 'Reporté'
        WHEN 'CI' THEN 'Complément d''information' 
        WHEN 'TRUE' THEN 'Approuvé'
         WHEN 'FALSE' THEN 'Reporté' 
         WHEN 'COND_APPROVE' THEN 'Avis avec réserves'
         WHEN 'REPORT' THEN 'Reporté'
         WHEN 'REJECT_END' THEN 'Non approuvé'
        else  'Avis' 
        end as decision,
    p.ref,
    p.nom,
    p.annee,
    p.budget_estime, DATE_FORMAT(p.created_at, '%d/%m/%Y') as createddate,
    m.com_id,
    m.nom as comnom, 'PPM' as type,
    p.actualise,
    a.nom as acnom
FROM reunion_ppm r
INNER JOIN ppm p
       ON r.ppm_id = p.ppm_id
      AND r.ppm_ver = p.ppm_ver
INNER JOIN ac a
       ON p.ac_id = a.ac_id
INNER JOIN com m on a.com_id = m.com_id
WHERE r.reunion_id =  $P{reunion} 
and m.com_id =  $P{com}  and r.decision is not null
AND   p.ppm_id = $P{ppm_id} AND p.ppm_ver = $P{ppm_ver}]]>
		</queryString>
