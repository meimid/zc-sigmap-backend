	<subDataset name="Dataset2" uuid="3724119d-925f-4032-8869-404f7961f454">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="reunion" class="java.lang.Integer"/>
		<parameter name="com" class="java.lang.Integer"/>
		<parameter name="dac_id" class="java.lang.Integer"/>
		<parameter name="dac_ver" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[SELECT distinct
    r.reunion_id,
    r.dac_id,
    r.dac_ver,
    r.observation,
   CASE UPPER(r.decision)
        WHEN 'APPROVE' THEN 'Approuvé'
        WHEN 'VALIDATE' THEN 'Approuvé'
        WHEN 'REJECT' THEN 'Rejeté'
        WHEN 'CI' THEN 'Complément d''information' 
        WHEN 'TRUE' THEN 'Approuvé'
         WHEN 'FALSE' THEN 'Rejeté' 
        else  'Avis' 
        end as decision,
    p.ref,
    p.nom,
    p.annee,
    p.budget_estime,  DATE_FORMAT(p.created_at, '%d/%m/%Y')  as createddate,
     m.com_id,
    m.nom as comnom, 'DAC' as type
FROM reunion_dac r
INNER JOIN dac d
       ON r.dac_id = d.dac_id
      AND r.dac_ver = d.dac_ver
    INNER JOIN  appel_offre ap on d.appel_offre_id=ap.appel_offre_id
    INNER JOIN ppm p on ap.ppm_id=p.ppm_id and ap.ppm_ver=p.ppm_ver
INNER JOIN ac a
       ON p.ac_id = a.ac_id
INNER JOIN com m on a.com_id = m.com_id
WHERE r.reunion_id =  $P{reunion}  
and m.com_id =  $P{com} and r.decision is not null
AND  d.dac_id = $P{dac_id} AND d.dac_ver = $P{dac_ver}]]>
		</queryString>
