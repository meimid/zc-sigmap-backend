	<parameter name="reunion" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT distinct  reunion_id,
	participant_id,
	type,
	nom,
	prenom,
	organisme,
	fonction,
	present
FROM  participant
where present=0
and reunion_id= $P{reunion} 
and is_deleted=0
and fonction_reunion <> 'PRESIDENT']]>
	</queryString>
