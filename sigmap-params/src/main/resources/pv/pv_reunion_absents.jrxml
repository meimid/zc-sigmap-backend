				<textElement verticalAlignment="Middle">
					<font fontName="Arial"/>
				</textElement>
				<textFieldExpression><![CDATA["- " + 
$F{nom} + " " + 
$F{prenom} + 
(
    $F{fonction} == null ? 
        "" 
        : $F{fonction}.trim().toUpperCase().equals("MEMBRE") ? 
            ", Membre" 
            : ", " + $F{fonction}.trim() + 
              ($F{organisme} == null || $F{organisme}.trim().isEmpty() ? 
