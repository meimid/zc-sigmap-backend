		<parameter name="reunion" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT reunion_id,
	participant_id,
	type,
	nom,
	prenom,
	organisme,
	fonction,
	present
FROM  participant
where present=1
and reunion_id= $P{reunion}
and fonction_reunion ='MEMBRE']]>
		</queryString>
