	<queryString>
		<![CDATA[SELECT reunion.reunion_id, 
reunion.reunion_num_com,
reunion.pv_id,
	 reunion.com_id,
	 reunion.reunion_date,
	 reunion.emplacement,
	 reunion.object,
	 com.com_id,
	 com.nom,
	 com.decret_creation,
	 com.special,
	 com.abrv,
	 com.nom_ar,
	 ref_param.code,
	 ac.nom as nom_tutel,
	 ac.nom_ar as nom_ar_ac,
	 ac.abrv as abrv_ac
FROM com
	INNER JOIN  reunion ON
	  reunion.com_id =  com.com_id
	INNER JOIN  ref_param ON
	  com.com_type_id =  ref_param.ref_param_id
	  left join  ac on com.tutel_id= ac.ac_id
	  where reunion.reunion_id =  $P{reunion}]]>
	</queryString>
