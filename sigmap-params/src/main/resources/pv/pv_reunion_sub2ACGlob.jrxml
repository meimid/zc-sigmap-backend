	<queryString language="SQL">
		<![CDATA[SELECT
    r.reunion_id,
    r.ppm_id,
    r.ppm_ver,
    r.observation,
    r.decision,
    p.ref,
    p.nom,
    p.annee,
    p.budget_estime,
    m.com_id,
    m.nom as comnom, 'PPM' as type
FROM reunion_ppm r
INNER JOIN ppm p
       ON r.ppm_id = p.ppm_id
      AND r.ppm_ver = p.ppm_ver
INNER JOIN ac a
       ON p.ac_id = a.ac_id
INNER JOIN com m on a.com_id = m.com_id
WHERE r.reunion_id =  $P{reunion}  and p.ac_id= $P{acId} 
union
SELECT
    r.reunion_id,
    r.dac_id,
    r.dac_ver,
    r.observation,
    r.decision,
    p.ref,
    p.nom,
    p.annee,
    p.budget_estime,
     m.com_id,
    m.nom as comnom, 'DAC' as type
FROM reunion_dac r
INNER JOIN dac d
       ON r.dac_id = d.dac_id
      AND r.dac_ver = d.dac_ver
     INNER JOIN  appel_offre ap on d.appel_offre_id=ap.appel_offre_id
    INNER JOIN ppm p on ap.ppm_id=p.ppm_id and ap.ppm_ver=p.ppm_ver 
INNER JOIN ac a
       ON p.ac_id = a.ac_id
INNER JOIN com m on a.com_id = m.com_id
WHERE r.reunion_id =   $P{reunion} and p.ac_id= $P{acId}]]>
