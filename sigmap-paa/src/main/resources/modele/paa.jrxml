			<property name="com.jaspersoft.studio.field.tree.path" value="realisation"/>
			<fieldDescription><![CDATA[Date prévue de lancement de la procédure de sélection]]></fieldDescription>
		</field>
		<field name="date_prev_ac" class="java.sql.Date">
			<property name="com.jaspersoft.studio.field.name" value="date_prev_ac"/>
			<property name="com.jaspersoft.studio.field.label" value="date_prev_ac"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="realisation"/>
			<fieldDescription><![CDATA[Date prévue d’attribution du contrat]]></fieldDescription>
		</field>
		<field name="libelle" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="libelle"/>
			<property name="com.jaspersoft.studio.field.label" value="libelle"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="mode_passation"/>
		</field>
		<field name="description" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="description"/>
			<property name="com.jaspersoft.studio.field.label" value="description"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ref_param"/>
		</field>
		<field name="imputbudg" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="description"/>
			<property name="com.jaspersoft.studio.field.label" value="imputbudg"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ref_param"/>
		</field>
	</subDataset>
	<parameter name="paa_id" class="java.lang.Integer"/>
	<parameter name="paa_ver" class="java.lang.Integer"/>
	<parameter name="nom" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct 
	 a.nom,a.abrv,
	 p.ac_id,
	 p.paa_ver,
	 p.paa_id,
	 p.ref,
	 p.nom as nompaa, p.annee,
	 rf.description
from realisation r
INNER JOIN paa_realisation pr ON
    r.realisation_id = pr.realisation_id
    AND r.realisation_ver = pr.realisation_ver
LEFT JOIN ref_param rf ON
    r.imputation_budgetaire_id = rf.ref_param_id
INNER JOIN paa p on pr.paa_id =p.paa_id and pr.paa_ver=p.paa_ver
INNER JOIN  ac a ON
	 p.ac_id = a.ac_id
WHERE pr.paa_id =   $P{paa_id} 
    AND pr.paa_ver =   $P{paa_ver}]]>
	</queryString>
