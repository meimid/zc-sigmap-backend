	<subDataset name="Dataset1" whenResourceMissingType="Empty" uuid="88474ae4-d9f1-4225-83b3-6febbf912452">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="295"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="700"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
		<parameter name="paa_id" class="java.lang.Integer"/>
		<parameter name="paa_ver" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT  p.paa_id,
	 p.paa_ver,
	 p.realisation_id,
	 p.realisation_ver,
	 COALESCE(r.realisation_envisagees, '') as realisation_envisagees,
	 GROUP_CONCAT(DISTINCT COALESCE(ls.description, '') ORDER BY l.lots_id ASC, l.lots_ver ASC SEPARATOR ' - ') AS lots,
	 r.beneficiaire,
	 r.date_prev_lps,
	 r.date_prev_ac,
	 r.date_prev_dp,
	 r.date_prev_ap,
	 GROUP_CONCAT(DISTINCT COALESCE(LTRIM(rp.description), '') SEPARATOR ' - ') AS sources_financement,
	 m.libelle,
	 f.description, rf.description as imputbudg
FROM  realisation r INNER JOIN  paa_realisation p ON
	  r.realisation_id =  p.realisation_id
	      and r.realisation_ver =  p.realisation_ver
	LEFT JOIN mode_passation m ON
	  r.mode_passation_id =  m.mode_passation_id
	LEFT JOIN  ref_param  f ON
	  r.type_marcher_id =  f.ref_param_id
	  LEFT JOIN  ref_param  rf ON
	  r.imputation_budgetaire_id =  rf.ref_param_id
	  LEFT JOIN finacement fin
    ON r.realisation_id= fin.realisation_id  and r.realisation_ver=fin.realisation_ver
    LEFT JOIN lots_realisation l
        ON r.realisation_id = l.realisation_id
        AND r.realisation_ver = l.realisation_ver
    LEFT JOIN lots ls
        ON l.lots_id = ls.lots_id
        AND l.lots_ver = ls.lots_ver
LEFT JOIN ref_param rp
    ON fin.source_de_financement_id = rp.ref_param_id
where p.paa_id= $P{paa_id}     and p.paa_ver=  $P{paa_ver} 
GROUP BY
    p.paa_id,
    p.paa_ver,
    p.realisation_id,
    p.realisation_ver,
    r.realisation_envisagees,
    r.beneficiaire,
    r.date_prev_lps,
    r.date_prev_ac,
    r.date_prev_dp,
    r.date_prev_ap,
    m.libelle,
    f.description]]>
		</queryString>
