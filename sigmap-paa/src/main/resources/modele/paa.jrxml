		</field>
		<sortField name="realisation_id"/>
		<sortField name="realisation_ver"/>
		<group name="paa_id">
			<groupExpression><![CDATA[$F{paa_id}]]></groupExpression>
		</group>
		<group name="paa_ver">
			<groupExpression><![CDATA[$F{paa_ver}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="paa_id" class="java.lang.Integer"/>
	<parameter name="paa_ver" class="java.lang.Integer"/>
	<parameter name="nom" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT d.adresse,
	 a.nom,
	 p.ac_id,
	 p.paa_ver,
	 p.paa_id,
	 p.ref,
	 p.nom as nompaa
FROM  paa p
	INNER JOIN  ac a ON 
	 p.ac_id = a.ac_id 
	LEFT JOIN adresse d ON 
	 a.adresse_id = d.adresse_id
	 where  p.paa_id= $P{paa_id} 
	 and p.paa_ver= $P{paa_ver}]]>
	</queryString>
