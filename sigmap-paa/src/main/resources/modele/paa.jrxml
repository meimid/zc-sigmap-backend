			<property name="com.jaspersoft.studio.field.name" value="realisation_envisagees"/>
			<property name="com.jaspersoft.studio.field.label" value="realisation_envisagees"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="realisation"/>
		</field>
		<field name="lots" class="java.lang.String">
