			<property name="com.jaspersoft.studio.field.label" value="description"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ref_param"/>
		</field>
		<field name="budget_estime" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="budget_estime"/>
			<property name="com.jaspersoft.studio.field.label" value="budget_estime"/>
		</field>
		<field name="budget_lots" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="budget_lots"/>
			<property name="com.jaspersoft.studio.field.label" value="budget_lots"/>
		</field>
		<sortField name="realisation_id"/>
		<sortField name="realisation_ver"/>
		<group name="ppm_id">
			<groupExpression><![CDATA[$F{ppm_id}]]></groupExpression>
