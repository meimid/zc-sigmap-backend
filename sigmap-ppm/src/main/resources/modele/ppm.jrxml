	<subDataset name="Dataset1" whenResourceMissingType="Empty" uuid="88474ae4-d9f1-4225-83b3-6febbf912452">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="295"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="700"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
		<parameter name="ppm_id" class="java.lang.Integer"/>
		<parameter name="ppm_ver" class="java.lang.Integer"/>
		<parameter name="nom" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[WITH lots_num AS (SELECT l.realisation_id, l.realisation_ver, l.lots_id, l.lots_ver, ls.description AS lot_description, ls.budget,
 	ROW_NUMBER() OVER ( PARTITION BY l.realisation_id, l.realisation_ver ORDER BY l.lots_id ASC, l.lots_ver ASC ) AS lot_num
 	FROM lots_realisation l
 	LEFT JOIN lots ls
 	ON l.lots_id = ls.lots_id
 	AND l.lots_ver = ls.lots_ver)
 
SELECT p.ppm_id,
  p.ppm_ver,
 p.realisation_id,
 p.realisation_ver,
 COALESCE(r.realisation_envisagees, '') AS realisation_envisagees,
  GROUP_CONCAT( DISTINCT CONCAT('Lot ', ln.lot_num, ' : ', COALESCE(ln.lot_description, '')) ORDER BY ln.lots_id ASC, ln.lots_ver ASC SEPARATOR ' - ' ) AS lots,
   r.beneficiaire,
 r.date_prev_lps,
 r.date_prev_ac,
  r.date_prev_dp,
  r.date_prev_ap,
   GROUP_CONCAT(DISTINCT COALESCE(LTRIM(rp.description), '') SEPARATOR ' - ') AS sources_financement,
  m.libelle,
 f.description,
 FORMAT(r.budget_estime, 0) as budget_estime,
   CASE
  WHEN MIN(ln.budget) IS NULL THEN NULL
 		ELSE GROUP_CONCAT(
 		DISTINCT CONCAT('Lot ', ln.lot_num, ' : ', FORMAT(ln.budget, 0))
 		ORDER BY ln.lots_id ASC, ln.lots_ver ASC
 		SEPARATOR ' - ')
END AS budget_lots
FROM ppm_realisation p
INNER JOIN realisation r
ON r.realisation_id = p.realisation_id
AND r.realisation_ver = p.realisation_ver
LEFT JOIN mode_passation m
ON r.mode_passation_id = m.mode_passation_id
LEFT JOIN ref_param f
ON r.type_marcher_id = f.ref_param_id
LEFT JOIN finacement fin
ON r.realisation_id = fin.realisation_id
AND r.realisation_ver = fin.realisation_ver
LEFT JOIN ref_param rp
ON fin.source_de_financement_id = rp.ref_param_id
LEFT JOIN lots_num ln
ON ln.realisation_id = r.realisation_id
AND ln.realisation_ver = r.realisation_ver
 WHERE
p.ppm_id =  $P{ppm_id} 
 AND p.ppm_ver =  $P{ppm_ver} 
 GROUP BY
    p.ppm_id,
    p.ppm_ver,
    p.realisation_id,
    p.realisation_ver,
    r.realisation_envisagees,
    r.beneficiaire,
    r.date_prev_lps,
    r.date_prev_ac,
    r.date_prev_dp,
    r.date_prev_ap,
    m.libelle,
    f.description,
    r.budget_estime]]>
		</queryString>
