	</subDataset>
	<parameter name="ppm_id" class="java.lang.Integer"/>
	<parameter name="ppm_ver" class="java.lang.Integer"/>
	<parameter name="nom" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT d.adresse,
	 a.nom,
	 p.ac_id,
	 p.ppm_ver,
	 p.ppm_id,
	 p.ref,
	 p.nom as nomppm
FROM  ppm p
	INNER JOIN  ac a ON 
	 p.ac_id = a.ac_id 
	LEFT JOIN adresse d ON 
	 a.adresse_id = d.adresse_id
	 where  p.ppm_id= $P{ppm_id} 
	 and p.ppm_ver= $P{ppm_ver}]]>
	</queryString>
