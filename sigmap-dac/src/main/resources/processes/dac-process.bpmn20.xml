<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="dacProcess" name="dac" isExecutable="true">

    <!-- START -->
    <startEvent id="Event_06b8v8q" name="Début" flowable:formFieldValidation="true">
      <outgoing>Flow_1c4qwmp</outgoing>
    </startEvent>

    <!-- Saisie -->
    <userTask id="saisieTask" name="Saisie DAC (AC)" flowable:candidateGroups="REDACTEUR_AC">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_1c4qwmp</incoming>
      <outgoing>Flow_00iv1ya</outgoing>
    </userTask>

    <sequenceFlow id="Flow_1c4qwmp" sourceRef="Event_06b8v8q" targetRef="saisieTask"/>
    <sequenceFlow id="Flow_00iv1ya" sourceRef="saisieTask" targetRef="Activity_0m03i99"/>

    <!-- Validation AC -->
    <userTask id="Activity_0m03i99" name="Validation (AC)" flowable:candidateGroups="VALIDATEUR_AC">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
      </extensionElements>
      <incoming>Flow_00iv1ya</incoming>
      <incoming>Flow_1faanus</incoming>
      <outgoing>Flow_0chj49b</outgoing>
    </userTask>

    <!-- Rectification -->
    <userTask id="Activity_1d2aib2" name="Rectification (AC)" flowable:candidateGroups="REDACTEUR_AC">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_036s2iv</incoming>
      <incoming>Flow_1w0kye6</incoming>
      <incoming>Flow_1f0e0oc</incoming>
      <outgoing>Flow_1faanus</outgoing>
    </userTask>

    <sequenceFlow id="Flow_1faanus" sourceRef="Activity_1d2aib2" targetRef="Activity_0m03i99">
      <extensionElements>
        <flowable:property name="actionLabel" value="Passer pour validation"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="Flow_0chj49b" sourceRef="Activity_0m03i99" targetRef="Gateway_13q8j1a"/>

    <!-- Gateway AC -->
    <exclusiveGateway id="Gateway_13q8j1a">
      <incoming>Flow_0chj49b</incoming>
      <outgoing>Flow_036s2iv</outgoing>
      <outgoing>Flow_1dsmkbd</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="Flow_036s2iv" sourceRef="Gateway_13q8j1a" targetRef="Activity_1d2aib2">
      <extensionElements>
        <flowable:property name="actionLabel" value="Reject"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${valide == false}]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_1dsmkbd" sourceRef="Gateway_13q8j1a" targetRef="Task_1vmbdxo">
      <extensionElements>
        <flowable:property name="actionLabel" value="Validate"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${valide == true}]]></conditionExpression>
    </sequenceFlow>

    <!-- Validation CPMP -->
    <userTask id="Task_1vmbdxo" name="Validation DAC (CPMP)" flowable:candidateGroups="CPMP-PLANIFICATEUR,CPMP-RAPPORTEUR">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="meetingRequired" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_1dsmkbd</incoming>
      <outgoing>SequenceFlow_0whoqkh</outgoing>
    </userTask>

    <sequenceFlow id="SequenceFlow_0whoqkh" sourceRef="Task_1vmbdxo" targetRef="ExclusiveGateway_1qgo4yf"/>

    <!-- Gateway CPMP -->
    <exclusiveGateway id="ExclusiveGateway_1qgo4yf">
      <incoming>SequenceFlow_0whoqkh</incoming>
      <outgoing>Flow_1w0kye6</outgoing>
      <outgoing>Flow_1y9t64n</outgoing>
      <outgoing>Flow_1cduuxo</outgoing>
      <outgoing>Flow_0jshl3l</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="Flow_1w0kye6" sourceRef="ExclusiveGateway_1qgo4yf" targetRef="Activity_1d2aib2">
      <extensionElements>
        <flowable:property name="actionLabel" value="Reject"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${cpmp_valide == false}]]></conditionExpression>
    </sequenceFlow>

    <!-- FIXED: No stray CDATA -->
    <sequenceFlow id="Flow_1y9t64n" sourceRef="ExclusiveGateway_1qgo4yf" targetRef="Task_0x68o40">
      <extensionElements>
        <flowable:property name="actionLabel" value="Validate"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[
        ${cpmp_valide == true && isRestraint == true && parentDacId == null}
      ]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_1cduuxo" sourceRef="ExclusiveGateway_1qgo4yf" targetRef="Task_1is7nge">
      <extensionElements>
        <flowable:property name="actionLabel" value="Validate"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[
        ${cpmp_valide == true && shortListing == false}
      ]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_0jshl3l" sourceRef="ExclusiveGateway_1qgo4yf" targetRef="Activity_0z9wkoj">
      <extensionElements>
        <flowable:property name="actionLabel" value="Transmettre"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[
        ${cpmp_valide == true && shortListing == true && parentDacId != null}
      ]]></conditionExpression>
    </sequenceFlow>

    <!-- Reserve CPMP -->
    <userTask id="Task_11nk76a" name="Reserve (CPMP)" flowable:candidateGroups="CPMP-PLANIFICATEUR,CPMP-RAPPORTEUR">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="meetingRequired" type="boolean" default="true"/>
      </extensionElements>
      <incoming>SequenceFlow_1bxbg8j</incoming>
      <outgoing>Flow_0a89jat</outgoing>
    </userTask>

    <sequenceFlow id="Flow_0a89jat" sourceRef="Task_11nk76a" targetRef="Gateway_0kkfgcl"/>

    <exclusiveGateway id="Gateway_0kkfgcl">
      <incoming>Flow_0a89jat</incoming>
      <outgoing>Flow_10ninyt</outgoing>
      <outgoing>Flow_1f0e0oc</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="Flow_10ninyt" sourceRef="Gateway_0kkfgcl" targetRef="Task_0x68o40">
      <extensionElements>
        <flowable:property name="actionLabel" value="Validate"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reserve_valide == true}]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_1f0e0oc" sourceRef="Gateway_0kkfgcl" targetRef="Activity_1d2aib2">
      <extensionElements>
        <flowable:property name="actionLabel" value="Reject"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reserve_valide == false}]]></conditionExpression>
    </sequenceFlow>

    <!-- CNCMP Affectation -->
    <userTask id="Task_0x68o40" name="(CNCMP) commission permanente Affectation"
              flowable:candidateGroups="CNCMP-PER-AFFECTATION">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="commissionRequired" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_1y9t64n</incoming>
      <incoming>Flow_10ninyt</incoming>
      <outgoing>Flow_1elinq9</outgoing>
    </userTask>

    <sequenceFlow id="Flow_1elinq9" sourceRef="Task_0x68o40" targetRef="Activity_08yp2o2">
      <extensionElements>
        <flowable:property name="actionLabel" value="Affecter"/>
      </extensionElements>
    </sequenceFlow>

    <!-- Avis SPE -->
    <userTask id="Activity_08yp2o2" name="(CNCMP) Avis sous-commission spécialisée"
              flowable:candidateGroups="CNCMP-SPE-PLANIFICATEUR,CNCMP-SPE-RAPPORTEUR">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="meetingRequired" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_1elinq9</incoming>
      <outgoing>Flow_11s0knn</outgoing>
    </userTask>

    <sequenceFlow id="Flow_11s0knn" sourceRef="Activity_08yp2o2" targetRef="Activity_1iyb3ly"/>

    <!-- CNCMP Decision -->
    <userTask id="Activity_1iyb3ly"
              name="(CNCMP) Décision commission permanente"
              flowable:candidateGroups="CNCMP-PER-PLANIFICATEUR,CNCMP-PER-RAPPORTEUR">

      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="meetingRequired" type="boolean" default="true"/>
        <flowable:formProperty id="cncmpDecision" type="enum" required="true">
          <flowable:value id="APPROVE" name="Approuver"/>
          <flowable:value id="REJECT" name="Réserver (CPMP)"/>
          <flowable:value id="CI" name="Révision SCS"/>
        </flowable:formProperty>
      </extensionElements>

      <incoming>Flow_11s0knn</incoming>
      <incoming>Flow_00u4k4q</incoming>
      <outgoing>Flow_0tt16gw</outgoing>
    </userTask>

    <sequenceFlow id="Flow_0tt16gw" sourceRef="Activity_1iyb3ly" targetRef="ExclusiveGateway_0a8t8oz"/>

    <exclusiveGateway id="ExclusiveGateway_0a8t8oz">
      <incoming>Flow_0tt16gw</incoming>
      <outgoing>SequenceFlow_1bxbg8j</outgoing>
      <outgoing>Flow_0ympl8t</outgoing>
      <outgoing>Flow_1xkshui</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_1bxbg8j" sourceRef="ExclusiveGateway_0a8t8oz" targetRef="Task_11nk76a">
      <extensionElements>
        <flowable:property name="actionLabel" value="Reject"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${cncmpDecision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="Flow_0ympl8t" sourceRef="ExclusiveGateway_0a8t8oz" targetRef="Activity_1lwas3w">
      <extensionElements>
        <flowable:property name="actionLabel" value="Complément d'information"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${cncmpDecision == 'CI'}]]></conditionExpression>
    </sequenceFlow>

    <userTask id="Activity_1lwas3w" name="(CNCMP) Révision sous-commission spécialisée"
              flowable:candidateGroups="CNCMP-SPE-PLANIFICATEUR,CNCMP-SPE-RAPPORTEUR">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="meetingRequired" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_0ympl8t</incoming>
      <outgoing>Flow_00u4k4q</outgoing>
    </userTask>

    <sequenceFlow id="Flow_00u4k4q" sourceRef="Activity_1lwas3w" targetRef="Activity_1iyb3ly">
      <extensionElements>
        <flowable:property name="actionLabel" value="Passer pour validation"/>
      </extensionElements>
    </sequenceFlow>

    <!-- Publication -->
    <userTask id="Task_1is7nge" name="(AC) Publication" flowable:candidateGroups="PUB_AC">
      <extensionElements>
        <flowable:formProperty id="isUpdatable" type="boolean" default="false"/>
        <flowable:formProperty id="isPublishable" type="boolean" default="true"/>
      </extensionElements>
      <incoming>Flow_1cduuxo</incoming>
      <outgoing>Flow_1jdhasv</outgoing>
    </userTask>

    <sequenceFlow id="Flow_1jdhasv" sourceRef="Task_1is7nge" targetRef="EndEvent_0tr7b0f"/>

    <endEvent id="EndEvent_0tr7b0f"/>

    <!-- Transmission DAO (APPROVE) -->
    <sequenceFlow id="Flow_1xkshui" sourceRef="ExclusiveGateway_0a8t8oz" targetRef="Activity_0u7tuz6">
      <extensionElements>
        <flowable:property name="actionLabel" value="Validate"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${cncmpDecision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>

    <serviceTask id="Activity_0u7tuz6" name="Transmission DAO + Lettre d’invitation aux candidats"
                 flowable:delegateExpression="${transmissionDaoDelegate}">
      <extensionElements>
        <flowable:property name="actionLabel" value="Transmission"/>
      </extensionElements>
      <incoming>Flow_1xkshui</incoming>
      <outgoing>Flow_04dfr0o</outgoing>
      <outgoing>Flow_19wptwx</outgoing>
    </serviceTask>

    <sequenceFlow id="Flow_04dfr0o" sourceRef="Activity_0u7tuz6" targetRef="EndEvent_0ighw33"/>
    <endEvent id="EndEvent_0ighw33"/>

    <!-- Transmission DAO (restrained) -->
    <serviceTask id="Activity_0z9wkoj" name="Transmission DAO + Lettre d’invitation aux candidats"
                 flowable:delegateExpression="${transmissionDaoDelegate}">
      <extensionElements>
        <flowable:property name="actionLabel" value="Transmettre"/>
      </extensionElements>
      <incoming>Flow_0jshl3l</incoming>
      <outgoing>Flow_036h7ls</outgoing>
      <outgoing>Flow_0jttfam</outgoing>
    </serviceTask>

    <sequenceFlow id="Flow_036h7ls" sourceRef="Activity_0z9wkoj" targetRef="EndEvent_0zb5443"/>
    <endEvent id="EndEvent_0zb5443"/>

    <sequenceFlow id="Flow_0jttfam" sourceRef="Activity_0z9wkoj" targetRef="Event_0vnf8l7"/>
    <endEvent id="Event_0vnf8l7"/>

    <sequenceFlow id="Flow_19wptwx" sourceRef="Activity_0u7tuz6" targetRef="Event_1eh3sit"/>
    <endEvent id="Event_1eh3sit"/>

  </process>
</definitions>
