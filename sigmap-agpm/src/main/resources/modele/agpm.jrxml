	<parameter name="agpm_id" class="java.lang.Integer"/>
	<parameter name="agpm_ver" class="java.lang.Integer"/>
	<parameter name="nom" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT d.adresse,
	 a.nom,
	 p.ac_id,
	 p.agpm_ver,
	 p.agpm_id,
	 p.ref,
	 p.nom as nomagpm,
	 p.contenu, 
	 p.annee
FROM  agpm p
	INNER JOIN  ac a ON 
	 p.ac_id = a.ac_id 
	LEFT JOIN adresse d ON 
	 a.adresse_id = d.adresse_id
	 where  p.agpm_id= $P{agpm_id} 
	 and p.agpm_ver= $P{agpm_ver}]]>
	</queryString>
